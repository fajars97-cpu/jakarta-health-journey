# Appwrite public project configuration. Collection IDs stay empty until the
# Phase 1 database is created. Never put an Appwrite API key in this file.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6aaa3b4a00230790a440
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_INQUIRIES_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_FEEDBACK_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_AUDIT_LOGS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_APPOINTMENTS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_PATIENT_PROFILES_COLLECTION_ID=

# Optional Appwrite team IDs used for shared operational permissions.
NEXT_PUBLIC_APPWRITE_FACILITY_TEAM_ID=
NEXT_PUBLIC_APPWRITE_COMMITTEE_TEAM_ID=

# Appwrite project session settings should match this client-side guard.
NEXT_PUBLIC_SESSION_MAX_AGE_HOURS=24
